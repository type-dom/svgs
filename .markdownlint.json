{
  "default": true,
  "extends": [
    "markdownlint-config-recommended"
  ],
  "rules": {
    "MD001": false,
    "MD003": {
      "style": "atx"
    },
    "MD004": {
      "style": "dash"
    },
    "MD007": {
      "indent": 2,
      "start_indented": false
    },
    "MD013": {
      "line_length": 1000,
      "code_block_line_length": 1000,
      "tables": false,
      "headings": false,
      "strict": false
    },
    "MD024": {
      "siblings_only": true,
      "allow_different_nesting": true
    },
    "MD025": {
      "level": 1,
      "front_matter_title": ""
    },
    "MD026": {
      "punctuation": ".,;:!"
    },
    "MD029": {
      "style": "one"
    },
    "MD033": false,
    "MD034": false,
    "MD036": false,
    "MD040": true,
    "MD041": false,
    "MD045": true,
    "MD046": {
      "style": "fenced"
    },
    "MD047": true,
    "MD048": {
      "style": "backtick"
    },
    "MD049": {
      "style": "underscore"
    },
    "MD050": {
      "style": "asterisk"
    }
  }
}
