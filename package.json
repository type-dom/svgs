{
  "name": "@type-dom/svgs",
  "version": "0.6.0",
  "description": "",
  "homepage": "https://github.com/type-dom/svgs#readme",
  "bugs": {
    "url": "https://github.com/type-dom/svgs/issues"
  },
  "license": "MIT",
  "author": "xjf <xjf7711@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/type-dom/svgs.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.mjs",
    "./common": "./dist/lib/common-index.mjs",
    "./element-plus": "./dist/lib/element-plus-index.mjs",
    "./fluentui": "./dist/lib/fluentui-index.mjs",
    "./mis": "./dist/lib/mis-index.mjs",
    "./other": "./dist/lib/other-index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "docs:api": "typedoc",
    "docs:watch": "typedoc --watch",
    "prepublishOnly": "npm run build && npm run docs:api",
    "prepare": "vp config",
    "common-svgs": "node trans-svgs/common-svg.mjs",
    "element-svgs": "node trans-svgs/element-svg.mjs",
    "fluentui-svgs": "node trans-svgs/fluentui-svg.mjs",
    "mis-svgs": "node trans-svgs/mis-svg.mjs",
    "docs:check": "markdownlint ai-docs/**/*.md && lychee ai-docs && cspell ai-docs/**/*.md",
    "docs:fix": "markdownlint ai-docs/**/*.md --fix",
    "docs:links": "lychee ai-docs/**/*.md --verbose",
    "docs:sync": "node scripts/sync-docs-version.mjs",
    "docs:stats": "node scripts/docs-statistics.mjs",
    "docs:rag-build": "python scripts/build-rag-kb.py",
    "docs:rag-index": "python scripts/index-rag-kb.py",
    "docs:quality": "npm run docs:check && npm run docs:stats"
  },
  "dependencies": {
    "@type-dom/framework": "^0.5.0",
    "@type-dom/parser": "^0.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "@typescript/native-preview": "7.0.0-dev.20260309.1",
    "bumpp": "^10.4.1",
    "changelogen": "^0.5.5",
    "cspell": "^8.3.2",
    "jest-extended": "^7.0.0",
    "lycheeverse": "^0.15.0",
    "markdownlint-cli": "^0.39.0",
    "textlint": "^13.4.1",
    "typedoc": "^0.27.0",
    "typescript": "^5.9.3",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "npm@11.11.1"
}
